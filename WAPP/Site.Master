<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="WAPP.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> </title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>

<body style="min-height: 100vh; display: flex; flex-direction: column; margin: 0;">
    <form runat="server" style="flex: 1; display: flex; flex-direction: column;">

        <asp:ScriptManager runat="server">
            <Scripts>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-sm navbar-dark"
             style="background: 
                    linear-gradient(to bottom, #001eff 10%, rgba(0,30,255,0)), 
                    linear-gradient(135deg, #eaf0ff, #ffffff);
                    background-blend-mode: normal;
                    position: fixed; top: 0; width: 100%; z-index: 1000;">
            <div class="container d-flex justify-content-between align-items-center">

                <a class="navbar-brand d-flex align-items-center" runat="server" href="~/public_dashboard" style="font-size:24px;">
                    Sea Learner 
                    <img src="/Image/sl_logo.png" alt="Sealearner" style="height:25px; margin-left:8px;"/>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav align-items-center" style="margin-top:0px;">

                        <li id="navSignIn" runat="server" class="nav-item mx-2">
                            <a class="btnSignIn" runat="server" href="~/sign_in">Sign-In</a>
                        </li>

                        <li id="navSignUp" runat="server" class="nav-item mx-2">
                            <a class="btnSignUp" runat="server" href="~/sign_up">Sign-Up</a>
                        </li>

                        <li id="navUserProfile" runat="server" class="nav-item d-flex align-items-center mx-2">
                            <a id="lnkProfile" runat="server" class="d-flex align-items-center text-white text-decoration-none">
                                <asp:Image ID="imgProfileHeader" runat="server" Width="35px" Height="35px"
                                           Style="border-radius:10px; margin-right:8px;" />
                                <div class="d-flex flex-column">
                                    <asp:Label ID="lblUserFullName" runat="server" Font-Bold="True"></asp:Label>
                                    <asp:Label ID="lblRole" runat="server" Font-Size="Small"></asp:Label>
                                </div>
                            </a>
                        </li>

                        <li id="navLogout" runat="server" class="nav-item mx-2">
                            <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-link bg-white text-dark border border-white rounded px-3"
                                            OnClick="Logout_Click">Logout</asp:LinkButton>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>

        <!-- Secondary menu bar -->
        <div id="menuBar" runat="server" style="width:100%; background-color:#f8f9fa; margin-top:60px; border-top:1px solid #ddd; border-bottom:1px solid #ddd;">
            <!-- Student Menu -->
            <div id="studentMenu" runat="server" visible="false" class="container d-flex justify-content-center py-2">
                <a href="StudentDashboard.aspx" class="mx-2 text-decoration-none text-dark">Student Dashboard</a>
                <a href="Feedback.aspx" class="mx-2 text-decoration-none text-dark">Feedback</a>
                <a href="Leaderboard.aspx" class="mx-2 text-decoration-none text-dark">Leaderboard</a>
                <a href="PrivateCourse.aspx" class="mx-2 text-decoration-none text-dark">Private Courses</a>
                <a href="PublicCourse.aspx" class="mx-2 text-decoration-none text-dark">Public Courses</a>
                <a href="StudentCourseContent.aspx" class="mx-2 text-decoration-none text-dark">Course Content</a>
                <a href="StudentLesson.aspx" class="mx-2 text-decoration-none text-dark">Lessons</a>
                <a href="StudentQuiz.aspx" class="mx-2 text-decoration-none text-dark">Quiz</a>
                <a href="StudentQuizResult.aspx" class="mx-2 text-decoration-none text-dark">Quiz Results</a>
            </div>

            <!-- educator Menu -->
            <div id="educatorMenu" runat="server" visible="false" class="container d-flex justify-content-center py-2">
                <a href="educatordashboard.aspx" class="mx-3 text-decoration-none text-dark fw-bold">Educator Dashboard</a>
            </div>

            <!-- Admin Menu -->
            <div id="adminMenu" runat="server" visible="false" class="container d-flex justify-content-center py-2">
                <a href="admin_dashboard.aspx" class="mx-3 text-decoration-none text-dark fw-bold">Admin Dashboard</a>
            </div>
        </div>

        <div class="container body-content" style="flex: 1; padding-top: 40px;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
        </div>

        <footer style="position: relative; overflow: hidden; height: 60%; color: white; text-align: center;">
            <!-- Background video -->
            <video autoplay muted loop playsinline 
                   style="position: absolute; top: 40%; left: 50%;
                          width: 100%; height: 140%; object-fit: cover;
                          transform: translate(-50%, -50%);
                          z-index: 0; opacity: 0.6;">
                <source src="/image/sea_wave.mp4" type="video/mp4">
            </video>

            <!-- Footer content -->
            <div style="position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; height: 100%;">
                <p style="color:white" class="m-0">&copy; <%: DateTime.Now.Year %> - Sealearner</p>
            </div>
        </footer>

    </form>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
